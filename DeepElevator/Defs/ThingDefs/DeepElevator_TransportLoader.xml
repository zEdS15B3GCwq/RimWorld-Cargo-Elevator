<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A vanilla map portal (the base MultiFloors' stairs use) that opens the vanilla portal dialog. Items are hauled into
       the loader's own container, and the deep elevator next to it pulls them out (Building_Elevator.Loaders.cs).
       People and animals walk or are carried through to the partner elevator's level directly.
       No <portal> properties: the portal never leads to a pocket map, and the class overrides what would use them. -->
  <ThingDef ParentName="BuildingBase">
    <defName>DeepElevator_TransportLoader</defName>
    <label>transport loader</label>
    <description>Sends a chosen list of items, and people and animals, through the elevator next to it, using the same window as other portals. Items ride the elevator; people and animals step out at the other end. Needs no power. Build it beside an elevator; it links to that elevator by itself, or use "Connect to..." when several elevators are adjacent.</description>
    <thingClass>DeepElevator.Building_TransportLoader</thingClass>
    <graphicData>
      <texPath>Things/Buildings/DeepElevator/DeepElevatorLoader</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType> <!-- needed: the game ticks the container contents through the building (food keeps rotting) -->
    <drawerType>MapMeshAndRealTime</drawerType> <!-- base sprite in the map mesh, the "loading" look drawn every frame -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <designationCategory>Misc</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius> <!-- a weak lamp while the orange look shows (blinks with it); tune in game -->
        <glowColor>(200,120,40,0)</glowColor>
      </li>
    </comps>
    <inspectorTabs>
      <li>DeepElevator.ITab_LoaderOrder</li> <!-- "Loading": the order (vanilla portal tab, renamed), visible only while an order is in progress -->
      <li>DeepElevator.ITab_LoaderContents</li> <!-- what waits in the container for the elevator -->
    </inspectorTabs>
    <placeWorkers>
      <li>DeepElevator.PlaceWorker_TransportLoader</li>
    </placeWorkers>
    <modExtensions>
      <li Class="DeepElevator.LoaderSettingsExtension">
        <lightTexPath>Things/Buildings/DeepElevator/DeepElevatorLoader_OrangeLight</lightTexPath> <!-- lights-only overlay, stays bright at night -->
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
