<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>DeepElevator_Elevator</defName>
    <label>deep elevator</label>
    <description>Transports items to a linked elevator on another level at the same world location (surface, DeepRim layers, MultiFloors levels). Build a second elevator at the same position, measured from the map center, on another level to link them.</description>
    <thingClass>DeepElevator.Building_Elevator</thingClass>
    <graphicData>
      <texPath>Things/Buildings/DeepElevator/DeepElevator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Storage</li>
      <li>DeepElevator.ITab_ElevatorContents</li>
    </inspectorTabs>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <designationCategory>Misc</designationCategory>
    <placeWorkers>
      <li>DeepElevator.PlaceWorker_Elevator</li>
    </placeWorkers>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
      <maxItemsInCell>1</maxItemsInCell>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <!-- no storageGroupTag: elevators must not be linked into shared storage groups -->
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Normal</priority>
        <!-- nothing allowed by default; same pattern as VFE hoppers (empty filter) -->
        <filter></filter>
      </defaultStorageSettings>
    </building>
    <comps>
      <li Class="CompProperties_Transporter">
        <massCapacity>100000</massCapacity> <!-- mass is not our capacity measure; slots are -->
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <shouldTickContents>true</shouldTickContents> <!-- buffered food keeps rotting -->
        <showMassInInspectString>false</showMassInInspectString>
      </li>
    </comps>
    <modExtensions>
      <li Class="DeepElevator.ElevatorSettingsExtension">
        <defaultSlots>4</defaultSlots>
        <minSlots>1</minSlots>
        <maxSlots>20</maxSlots>
        <ticksPerStack>60</ticksPerStack> <!-- one piece per second -->
        <heldRetryTicks>-1</heldRetryTicks> <!-- -1 = same as ticksPerStack -->
        <defaultFifo>true</defaultFifo>
        <defaultMerge>true</defaultMerge>
        <defaultAllowDrop>true</defaultAllowDrop>
      </li>
    </modExtensions>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>
</Defs>
