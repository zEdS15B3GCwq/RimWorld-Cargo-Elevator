<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <DeepElevator_CandidatesAvailable>{0} unconnected elevator(s) at this position on other levels. Use "Connect to...".</DeepElevator_CandidatesAvailable>
  <DeepElevator_Connect>Connect to...</DeepElevator_Connect>
  <DeepElevator_ConnectDesc>Link this elevator to an unconnected elevator at the same position on another level. The link cannot be changed afterwards.</DeepElevator_ConnectDesc>
  <DeepElevator_MsgLinked>Elevator connected to {0}.</DeepElevator_MsgLinked>
  <DeepElevator_MsgUnlinked>Elevator lost its connection to {0}.</DeepElevator_MsgUnlinked>

  <!-- Level labels: {0} = depth in metres, {1} = player-given layer name. -->
  <DeepElevator_DeepRimDepth>{0}m</DeepElevator_DeepRimDepth>
  <DeepElevator_DeepRimDepthNamed>{0}m {1}</DeepElevator_DeepRimDepthNamed>
  <DeepElevator_TagDeepRim>DeepRim</DeepElevator_TagDeepRim>
  <DeepElevator_TagMultiFloors>MultiFloors</DeepElevator_TagMultiFloors>
  <DeepElevator_LabelWithTag>{0} ({1})</DeepElevator_LabelWithTag>
  <DeepElevator_LabelSeparator>, </DeepElevator_LabelSeparator>
  <!-- {0} = map id, {1} = the label of the map's level. -->
  <DeepElevator_MapPrefix>map{0} - {1}</DeepElevator_MapPrefix>
  <DeepElevator_Surface>surface</DeepElevator_Surface>
  <DeepElevator_VanillaLabel>{0} (map {1})</DeepElevator_VanillaLabel>
  <!-- {0} = the elevator's custom name, {1} = its level label. -->
  <DeepElevator_ElevatorOnLevel>{0} on {1}</DeepElevator_ElevatorOnLevel>

  <DeepElevator_HelperConnectsTo>Connects to: {0}</DeepElevator_HelperConnectsTo>
  <!-- {0} = level label of the smaller map that doesn't reach the hovered cell. -->
  <DeepElevator_HelperOutsideMap>Outside the boundaries of {0}</DeepElevator_HelperOutsideMap>

  <DeepElevator_GoToPartner>Go to partner</DeepElevator_GoToPartner>
  <DeepElevator_GoToPartnerDesc>Jump to the linked elevator on the other level.</DeepElevator_GoToPartnerDesc>

  <!-- Step C: buffer, modes, holding -->
  <DeepElevator_BufferSlots>Buffer: {0} / {1} stacks</DeepElevator_BufferSlots>
  <!-- {0} = the held stacks with their short reasons. -->
  <DeepElevator_Paused>Transfer paused: {0}.</DeepElevator_Paused>
  <DeepElevator_PausedStorageFull>storage full</DeepElevator_PausedStorageFull>
  <DeepElevator_PausedNoStorage>no storage</DeepElevator_PausedNoStorage>
  <DeepElevator_PausedFifoWaiting>FIFO on</DeepElevator_PausedFifoWaiting>
  <DeepElevator_PausedNotConnected>not connected</DeepElevator_PausedNotConnected>
  <!-- Either end unpowered. -->
  <DeepElevator_PausedNoPower>no power</DeepElevator_PausedNoPower>
  <!-- Replace the item list when one reason applies to every held stack, or to all stacks behind the FIFO head. -->
  <DeepElevator_PausedAllItems>all items</DeepElevator_PausedAllItems>
  <DeepElevator_PausedAllOthers>all others</DeepElevator_PausedAllOthers>
  <DeepElevator_Unload>Unload</DeepElevator_Unload>
  <DeepElevator_UnloadDesc>Put everything in this elevator's buffer down nearby. Pawns will haul it to storage.</DeepElevator_UnloadDesc>
  <DeepElevator_UnloadEmpty>The buffer is empty.</DeepElevator_UnloadEmpty>
  <DeepElevator_UnloadIncomplete>{0}: no room nearby for {1} item stack(s); they stay in the elevator.</DeepElevator_UnloadIncomplete>
  <DeepElevator_ToggleFifo>First in, first out</DeepElevator_ToggleFifo>
  <DeepElevator_ToggleFifoDesc>On: the buffer is sent strictly in order; if the first entry can't be delivered, everything waits. Off: the first entry that can be delivered is sent.</DeepElevator_ToggleFifoDesc>
  <DeepElevator_ToggleMerge>Merge stacks</DeepElevator_ToggleMerge>
  <DeepElevator_ToggleMergeDesc>On: arriving items join any buffered stack of the same kind. Off: every arrival is kept as its own entry.</DeepElevator_ToggleMergeDesc>
  <DeepElevator_ToggleDrop>Drop on floor near target</DeepElevator_ToggleDrop>
  <DeepElevator_ToggleDropDesc>On: items that no storage next to the linked elevator accepts are put down on a free cell next to it. Off: such items wait in this elevator.</DeepElevator_ToggleDropDesc>
  <DeepElevator_ToggleInsert>Allow insert</DeepElevator_ToggleInsert>
  <DeepElevator_ToggleInsertDesc>On: colonists haul items into this elevator. Off: colonists leave it alone, so it only receives from conveyor belts and other mods. Items already on their way still arrive. Transport loaders are not affected: this elevator still pulls from them.</DeepElevator_ToggleInsertDesc>
  <DeepElevator_SlotsLess>Fewer slots</DeepElevator_SlotsLess>
  <DeepElevator_SlotsMore>More slots</DeepElevator_SlotsMore>
  <!-- Step D: status line. {0} = status text, {1} = partner label (ElevatorLabel). -->
  <DeepElevator_StatusLinked>Status: {0}, connected to {1}</DeepElevator_StatusLinked>
  <DeepElevator_StatusUnlinked>Status: {0}</DeepElevator_StatusUnlinked>
  <DeepElevator_StatusDisconnected>disconnected</DeepElevator_StatusDisconnected>
  <DeepElevator_StatusNoPower>no power</DeepElevator_StatusNoPower>
  <DeepElevator_StatusPartnerUnpowered>partner unpowered</DeepElevator_StatusPartnerUnpowered>
  <!-- Disconnected and unpowered at once: {0} = no power text, {1} = disconnected text. -->
  <DeepElevator_StatusUnpoweredDisconnected>{0}, {1}</DeepElevator_StatusUnpoweredDisconnected>
  <DeepElevator_StatusBlocked>blocked</DeepElevator_StatusBlocked>
  <DeepElevator_StatusActive>active</DeepElevator_StatusActive>
  <DeepElevator_StatusIdle>idle</DeepElevator_StatusIdle>
  <DeepElevator_SlotsDesc>Buffer size in slots. A slot holds one full stack. Currently {0}.</DeepElevator_SlotsDesc>
  <!-- Step E1: transport loader -->
  <DeepElevator_MsgLoaderLinked>Transport loader linked to {0}.</DeepElevator_MsgLoaderLinked>
  <DeepElevator_MsgLoaderUnlinked>Transport loader lost its elevator. Loading continues, but nothing is transferred until you turn "Transfer items to elevator" back on.</DeepElevator_MsgLoaderUnlinked>
  <DeepElevator_LoaderNeedsLink>The loader is not linked to an elevator. Build it next to one, or use "Connect to...".</DeepElevator_LoaderNeedsLink>
  <DeepElevator_ToggleTransfer>Transfer items to elevator</DeepElevator_ToggleTransfer>
  <DeepElevator_ToggleTransferDesc>On: the linked elevator takes loaded items out of this loader as soon as it has room. Off: loaded items stay here until you unload them.</DeepElevator_ToggleTransferDesc>
  <!-- {0} = the current priority level. -->
  <DeepElevator_LoaderPriority>Priority: {0}</DeepElevator_LoaderPriority>
  <DeepElevator_LoaderPriorityDesc>When several loaders are linked to one elevator, the elevator takes items from the higher priority loader first.</DeepElevator_LoaderPriorityDesc>
  <DeepElevator_LoaderConnectDesc>Link this loader to one of the elevators next to it. The link stays until one of them is removed.</DeepElevator_LoaderConnectDesc>
  <!-- {0} = elevator label, {1} = direction from the loader. -->
  <DeepElevator_LoaderLinkedTo>Linked to: {0} ({1})</DeepElevator_LoaderLinkedTo>
  <DeepElevator_DirectionNorth>north</DeepElevator_DirectionNorth>
  <DeepElevator_DirectionEast>east</DeepElevator_DirectionEast>
  <DeepElevator_DirectionSouth>south</DeepElevator_DirectionSouth>
  <DeepElevator_DirectionWest>west</DeepElevator_DirectionWest>
  <!-- Parts of the loader's status line, joined with "; ". -->
  <DeepElevator_LoaderStatusLoading>loading</DeepElevator_LoaderStatusLoading>
  <DeepElevator_LoaderStatusNotLinked>not linked</DeepElevator_LoaderStatusNotLinked>
  <DeepElevator_LoaderStatusTransferOff>transfer off</DeepElevator_LoaderStatusTransferOff>
  <DeepElevator_LoaderStatusCannotAccept>elevator cannot accept</DeepElevator_LoaderStatusCannotAccept>
  <DeepElevator_LoaderStatusTransferring>transferring items</DeepElevator_LoaderStatusTransferring>
  <!-- Step E2: portal loader. -->
  <DeepElevator_LoaderPairDown>the elevator is not connected or has no power</DeepElevator_LoaderPairDown>
  <!-- {0} = pawn name, {1} = loader label. -->
  <DeepElevator_MsgLoaderPawnReturned>{0} could not go through {1}: the elevator is not connected or has no power. Put down next to the loader.</DeepElevator_MsgLoaderPawnReturned>
  <!-- {0} = loader label, {1} = number of stacks. -->
  <DeepElevator_LoaderUnloadIncomplete>{0}: no room nearby for {1} item stack(s); they stay in the loader.</DeepElevator_LoaderUnloadIncomplete>
  <!-- Step E2 tests: wording. The order tab and its cancel button belong to the vanilla portal; these replace "Travel" and "Cancel entering". -->
  <DeepElevator_TabLoaderOrder>Loading</DeepElevator_TabLoaderOrder>
  <DeepElevator_LoaderCancelOrder>Cancel loading</DeepElevator_LoaderCancelOrder>
  <DeepElevator_LoaderOrderHeader>Still to be sent</DeepElevator_LoaderOrderHeader>
  <DeepElevator_LoaderElevatorNotConnected>The linked elevator is not connected to an elevator on another level.</DeepElevator_LoaderElevatorNotConnected>
  <DeepElevator_LoaderStatusTransferOn>transfer on</DeepElevator_LoaderStatusTransferOn>
  <!-- {0} = the current priority level. -->
  <DeepElevator_LoaderStatusPriority>priority: {0}</DeepElevator_LoaderStatusPriority>
  <!-- Closes the elevator's status line. {0} = number of linked loaders, {1} = their directions, e.g. "N, ESE". -->
  <DeepElevator_StatusLoaders>{0} loaders: {1}</DeepElevator_StatusLoaders>
  <DeepElevator_StatusLoaderSingle>{0} loader: {1}</DeepElevator_StatusLoaderSingle>
  <!-- Compass letters; a direction is these put together (NNW, ESE, ...). -->
  <DeepElevator_CompassN>N</DeepElevator_CompassN>
  <DeepElevator_CompassE>E</DeepElevator_CompassE>
  <DeepElevator_CompassS>S</DeepElevator_CompassS>
  <DeepElevator_CompassW>W</DeepElevator_CompassW>
  <!-- The loader's command that opens the vanilla portal dialog. -->
  <DeepElevator_LoaderOpenMenu>Open transport menu</DeepElevator_LoaderOpenMenu>
  <DeepElevator_LoaderOpenMenuDesc>Choose what to send through the elevator: items, people and animals. While an order is in progress, this also changes it.</DeepElevator_LoaderOpenMenuDesc>
  <DeepElevator_HelperSeveralElevators>Several elevators: use Connect to...</DeepElevator_HelperSeveralElevators>
</LanguageData>
