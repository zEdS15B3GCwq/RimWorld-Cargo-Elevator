<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CargoElevator</RootNamespace>
    <AssemblyName>CargoElevator</AssemblyName>

    <!-- The mod folder is the output: the game loads CargoElevator\1.6\Assemblies\CargoElevator.dll. -->
    <OutputPath>CargoElevator\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Compile only our own sources (not Examples\ or build output); XML files are listed below for VS only. -->
    <EnableDefaultItems>false</EnableDefaultItems>

    <Version>1.0.0.0</Version>
    <Product>CargoElevator</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>include\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>include\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>include\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony comes from the Harmony mod (a dependency in About.xml), not from our output folder. -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>include\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="CargoElevator\Source\**\*.cs" />
    <None Include="CargoElevator\**\*.xml" />
  </ItemGroup>

</Project>
