<?xml version="1.0" encoding="utf-8"?>
<!-- Better Architect Menu without MultiFloors: our buildings go to Better Architect Menu's own Structure > Elevation
     tab, the same place they take when MultiFloors is active too. Our own tab is removed. -->
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="CargoElevatorBase" or defName="CargoElevator_TransportLoader"]/designationCategory</xpath>
    <value>
      <designationCategory>Ferny_Elevation</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/DesignationCategoryDef[defName="CargoElevator"]</xpath>
  </Operation>
</Patch>
