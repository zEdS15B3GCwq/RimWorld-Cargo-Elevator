<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeepElevator</RootNamespace>
    <AssemblyName>DeepElevator</AssemblyName>

    <!-- The mod folder is the output: the game loads DeepElevator\1.6\Assemblies\DeepElevator.dll. -->
    <OutputPath>DeepElevator\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Compile only our own sources (not Examples\ or build output); XML files are listed below for VS only. -->
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- DeepRim is built against .NET 4.8.1; the game loads it fine, so accept the newer reference. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>

    <Version>1.0.0.0</Version>
    <Product>DeepElevator</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\Games\RimWorld\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\Games\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="DeepRim">
      <HintPath>C:\Games\RimWorld\Mods\2164179860\1.6\Assemblies\DeepRim.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DeepElevator\Source\**\*.cs" />
    <None Include="DeepElevator\**\*.xml" />
  </ItemGroup>

</Project>
